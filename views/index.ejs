<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Information Management System</title>
    <style>
        :root {
            --emerald: #10b981;
            --midnight: #0f172a;
            --glass: rgba(255, 255, 255, 0.05);
            --border: rgba(255, 255, 255, 0.1);
        }

        body {
            background: var(--midnight);
            color: #f8fafc;
            font-family: 'Inter', sans-serif;
            margin: 0;
            scroll-behavior: smooth;
        }

        /* 1. NAVIGATION MENU */
        nav {
            background: rgba(15, 23, 42, 0.9);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border);
            padding: 15px 50px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        nav .brand { font-size: 1.4rem; font-weight: bold; color: var(--emerald); text-decoration: none; }
        nav ul { list-style: none; display: flex; gap: 25px; margin: 0; }
        nav ul li a { color: #f8fafc; text-decoration: none; font-size: 0.9rem; transition: 0.3s; }
        nav ul li a:hover { color: var(--emerald); }

        .container { max-width: 1100px; margin: 40px auto; padding: 0 20px; }

        /* 2. HOMEPAGE HERO SECTION */
        .hero {
            text-align: center;
            padding: 60px 20px;
            background: var(--glass);
            border-radius: 20px;
            border: 1px solid var(--border);
            margin-bottom: 40px;
        }

        .hero h1 { font-size: 2.5rem; margin-bottom: 10px; }
        .hero p { color: #94a3b8; font-size: 1.1rem; }

        /* CARDS & FORMS */
        .card {
            background: var(--glass);
            backdrop-filter: blur(10px);
            border: 1px solid var(--border);
            border-radius: 15px;
            padding: 30px;
            margin-bottom: 40px;
        }

        h2 { color: var(--emerald); margin-bottom: 25px; font-size: 1.5rem; border-left: 4px solid var(--emerald); padding-left: 15px; }

        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 20px;
        }

        .input-box { display: flex; flex-direction: column; gap: 8px; }
        .input-box label { font-size: 0.8rem; color: #94a3b8; }
        
        input, select {
            background: rgba(15, 23, 42, 0.6);
            border: 1px solid #334155;
            color: white;
            padding: 12px;
            border-radius: 8px;
            outline: none;
        }

        input:focus { border-color: var(--emerald); }

        .btn {
            background: var(--emerald);
            color: white;
            border: none;
            padding: 12px 25px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 20px;
            transition: 0.3s;
        }

        .btn:hover { background: #059669; transform: translateY(-2px); }
        .btn-cancel { background: #475569; margin-left: 10px; text-decoration: none; font-size: 0.9rem; color: white; padding: 12px 20px; border-radius: 8px; }

        /* 3. STUDENT LIST TABLE */
        table { width: 100%; border-collapse: collapse; margin-top: 10px; }
        th { text-align: left; padding: 15px; color: var(--emerald); border-bottom: 2px solid #1e293b; font-size: 0.85rem; text-transform: uppercase; }
        td { padding: 15px; border-bottom: 1px solid #1e293b; font-size: 0.9rem; }

        .badge { background: rgba(16, 185, 129, 0.1); color: var(--emerald); padding: 4px 8px; border-radius: 4px; font-size: 0.8rem; }
        .actions a { text-decoration: none; font-weight: bold; margin-right: 15px; font-size: 0.85rem; }
        .edit-link { color: #60a5fa; }
        .delete-link { color: #f87171; }
    </style>
</head>
<body>

    <!-- 1. NAVIGATION MENU -->
    <nav>
        <a href="/" class="brand">SIMS PRO</a>
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="#registration">Register</a></li>
            <li><a href="#table">Student List</a></li>
        </ul>
    </nav>

    <div class="container">

        <!-- 2. HOMEPAGE SECTION -->
        <section class="hero">
            <h1>Student Information System</h1>
            <p>IT318 Final Practical Examination - Web Development</p>
        </section>

        <!-- 3. EDIT STUDENT FORM (Only shows when editing) -->
        <% if (editStudent) { %>
        <section id="edit-form" class="card" style="border: 1px solid #60a5fa;">
            <h2>Edit Student Form</h2>
            <form action="/update/<%= editStudent.id %>" method="POST">
                <div class="form-grid">
                    <div class="input-box">
                        <label>Student ID</label>
                        <input type="text" name="student_id" value="<%= editStudent.student_id %>" required>
                    </div>
                    <div class="input-box">
                        <label>Full Name</label>
                        <input type="text" name="full_name" value="<%= editStudent.full_name %>" required>
                    </div>
                    <div class="input-box">
                        <label>Course</label>
                        <input type="text" name="course" value="<%= editStudent.course %>" required>
                    </div>
                    <div class="input-box">
                        <label>Year Level</label>
                        <select name="year_level">
                            <option <%= editStudent.year_level == '1st Year' ? 'selected' : '' %>>1st Year</option>
                            <option <%= editStudent.year_level == '2nd Year' ? 'selected' : '' %>>2nd Year</option>
                            <option <%= editStudent.year_level == '3rd Year' ? 'selected' : '' %>>3rd Year</option>
                            <option <%= editStudent.year_level == '4th Year' ? 'selected' : '' %>>4th Year</option>
                        </select>
                    </div>
                    <div class="input-box">
                        <label>Email Address</label>
                        <input type="email" name="email_address" value="<%= editStudent.email_address %>" required>
                    </div>
                </div>
                <button type="submit" class="btn">Update Records</button>
                <a href="/" class="btn-cancel">Cancel</a>
            </form>
        </section>
        <% } %>

        <!-- 4. STUDENT REGISTRATION FORM (Always visible unless editing) -->
        <% if (!editStudent) { %>
        <section id="registration" class="card">
            <h2>Student Registration Form</h2>
            <form action="/add" method="POST">
                <div class="form-grid">
                    <div class="input-box">
                        <label>Student ID</label>
                        <input type="text" name="student_id" placeholder="e.g. 2024-0001" required>
                    </div>
                    <div class="input-box">
                        <label>Full Name</label>
                        <input type="text" name="full_name" placeholder="John Doe" required>
                    </div>
                    <div class="input-box">
                        <label>Course</label>
                        <input type="text" name="course" placeholder="BSIT" required>
                    </div>
                    <div class="input-box">
                        <label>Year Level</label>
                        <select name="year_level">
                            <option>1st Year</option>
                            <option>2nd Year</option>
                            <option>3rd Year</option>
                            <option>4th Year</option>
                        </select>
                    </div>
                    <div class="input-box">
                        <label>Email Address</label>
                        <input type="email" name="email_address" placeholder="john@example.com" required>
                    </div>
                </div>
                <button type="submit" class="btn">Register Student</button>
            </form>
        </section>
        <% } %>

        <!-- 5. STUDENT LIST TABLE -->
        <section id="table" class="card">
            <h2>Student List Table</h2>
            <div style="overflow-x: auto;">
                <table>
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Full Name</th>
                            <th>Course</th>
                            <th>Year</th>
                            <th>Email</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% students.forEach(student => { %>
                        <tr>
                            <td><%= student.student_id %></td>
                            <td><%= student.full_name %></td>
                            <td><span class="badge"><%= student.course %></span></td>
                            <td><%= student.year_level %></td>
                            <td><%= student.email_address %></td>
                            <td class="actions">
                                <a href="/edit/<%= student.id %>" class="edit-link">Edit</a>
                                <a href="/delete/<%= student.id %>" class="delete-link" onclick="return confirm('Delete this student?')">Delete</a>
                            </td>
                        </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        </section>

    </div>
</body>
</html>