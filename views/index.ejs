<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>IT318 - Student Information Management System</title>
    <style>
        :root {
            --emerald: #10b981;
            --midnight: #0f172a;
            --glass: rgba(255, 255, 255, 0.05);
            --border: rgba(255, 255, 255, 0.1);
        }

        body {
            background: var(--midnight);
            background-image: radial-gradient(circle at top right, #1e293b, #0f172a);
            color: #f8fafc;
            font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
            min-height: 100vh;
        }

        /* NAVIGATION MENU (Required) */
        nav {
            background: rgba(15, 23, 42, 0.8);
            backdrop-filter: blur(10px);
            border-bottom: 1px solid var(--border);
            padding: 1rem 2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        nav .logo {
            font-size: 1.5rem;
            font-weight: bold;
            color: var(--emerald);
            text-decoration: none;
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 20px;
            margin: 0;
        }

        nav ul li a {
            color: #94a3b8;
            text-decoration: none;
            transition: 0.3s;
        }

        nav ul li a:hover {
            color: var(--emerald);
        }

        /* CONTAINER */
        .container {
            max-width: 1100px;
            margin: 40px auto;
            padding: 0 20px;
        }

        /* GLASS CARD (Required Forms) */
        .glass-card {
            background: var(--glass);
            backdrop-filter: blur(12px);
            border: 1px solid var(--border);
            border-radius: 16px;
            padding: 30px;
            margin-bottom: 40px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.5);
        }

        h2 {
            margin-top: 0;
            color: var(--emerald);
            font-weight: 500;
        }

        /* FORM STYLING */
        .form-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
        }

        .input-group {
            display: flex;
            flex-direction: column;
        }

        label {
            font-size: 0.85rem;
            margin-bottom: 5px;
            color: #94a3b8;
        }

        input, select {
            background: rgba(0, 0, 0, 0.2);
            border: 1px solid #334155;
            color: white;
            padding: 12px;
            border-radius: 8px;
            outline: none;
            transition: 0.3s;
        }

        input:focus, select:focus {
            border-color: var(--emerald);
            box-shadow: 0 0 0 2px rgba(16, 185, 129, 0.2);
        }

        .btn-submit {
            background: var(--emerald);
            color: white;
            border: none;
            padding: 12px 24px;
            border-radius: 8px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 15px;
            transition: 0.3s;
        }

        .btn-submit:hover {
            background: #059669;
            transform: translateY(-2px);
        }

        /* TABLE STYLING (Required) */
        .table-container {
            overflow-x: auto;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 10px;
        }

        th {
            text-align: left;
            padding: 15px;
            background: rgba(16, 185, 129, 0.1);
            color: var(--emerald);
            font-size: 0.9rem;
            text-transform: uppercase;
        }

        td {
            padding: 15px;
            border-bottom: 1px solid #1e293b;
            font-size: 0.95rem;
        }

        .action-btns {
            display: flex;
            gap: 10px;
        }

        .edit-btn { color: #60a5fa; text-decoration: none; font-weight: bold; }
        .del-btn { color: #f87171; text-decoration: none; font-weight: bold; }
    </style>
</head>
<body>

    <!-- NAVIGATION MENU -->
    <nav>
        <a href="/" class="logo">SIMS Portal</a>
        <ul>
            <li><a href="/">Homepage</a></li>
            <li><a href="#register">Registration</a></li>
            <li><a href="#list">Student List</a></li>
        </ul>
    </nav>

    <div class="container">
        
        <!-- EDIT / REGISTRATION FORM SECTION -->
        <section id="register">
            <div class="glass-card">
                <h2>
                    <% if (editStudent) { %>
                        <span style="color: #60a5fa;">Edit Student Form</span>
                    <% } else { %>
                        Student Registration Form
                    <% } %>
                </h2>
                
                <form action="<%= editStudent ? '/update/' + editStudent.id : '/add' %>" method="POST">
                    <div class="form-grid">
                        <div class="input-group">
                            <label>Student ID</label>
                            <input type="text" name="student_id" value="<%= editStudent ? editStudent.student_id : '' %>" required>
                        </div>
                        <div class="input-group">
                            <label>Full Name</label>
                            <input type="text" name="full_name" value="<%= editStudent ? editStudent.full_name : '' %>" required>
                        </div>
                        <div class="input-group">
                            <label>Course</label>
                            <input type="text" name="course" value="<%= editStudent ? editStudent.course : '' %>" required>
                        </div>
                        <div class="input-group">
                            <label>Year Level</label>
                            <select name="year_level" required>
                                <option value="1st Year" <%= editStudent && editStudent.year_level === '1st Year' ? 'selected' : '' %>>1st Year</option>
                                <option value="2nd Year" <%= editStudent && editStudent.year_level === '2nd Year' ? 'selected' : '' %>>2nd Year</option>
                                <option value="3rd Year" <%= editStudent && editStudent.year_level === '3rd Year' ? 'selected' : '' %>>3rd Year</option>
                                <option value="4th Year" <%= editStudent && editStudent.year_level === '4th Year' ? 'selected' : '' %>>4th Year</option>
                            </select>
                        </div>
                        <div class="input-group">
                            <label>Email Address</label>
                            <input type="email" name="email_address" value="<%= editStudent ? editStudent.email_address : '' %>" required>
                        </div>
                    </div>
                    
                    <div style="display: flex; align-items: center; gap: 15px;">
                        <button type="submit" class="btn-submit">
                            <%= editStudent ? 'Save Changes' : 'Register Student' %>
                        </button>
                        <% if (editStudent) { %>
                            <a href="/" style="color: #94a3b8; text-decoration: none; margin-top: 15px;">Cancel Edit</a>
                        <% } %>
                    </div>
                </form>
            </div>
        </section>

        <!-- STUDENT LIST TABLE SECTION -->
        <section id="list">
            <div class="glass-card">
                <h2>Student List Table</h2>
                <div class="table-container">
                    <table>
                        <thead>
                            <tr>
                                <th>Student ID</th>
                                <th>Name</th>
                                <th>Course</th>
                                <th>Year Level</th>
                                <th>Email</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% if (students.length > 0) { %>
                                <% students.forEach(student => { %>
                                    <tr>
                                        <td><%= student.student_id %></td>
                                        <td><%= student.full_name %></td>
                                        <td><%= student.course %></td>
                                        <td><%= student.year_level %></td>
                                        <td><%= student.email_address %></td>
                                        <td class="action-btns">
                                            <a href="/edit/<%= student.id %>" class="edit-btn">Edit</a>
                                            <a href="/delete/<%= student.id %>" class="del-btn" onclick="return confirm('Delete record?')">Delete</a>
                                        </td>
                                    </tr>
                                <% }) %>
                            <% } else { %>
                                <tr>
                                    <td colspan="6" style="text-align: center; color: #64748b;">No students found.</td>
                                </tr>
                            <% } %>
                        </tbody>
                    </table>
                </div>
            </div>
        </section>

    </div>

</body>
</html>