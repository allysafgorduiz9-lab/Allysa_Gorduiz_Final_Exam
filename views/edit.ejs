<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Student - SIS</title>
    <style>
        :root {
            --emerald: #10b981;
            --emerald-dark: #059669;
            --bg-light: #f8fafc;
            --glass-white: rgba(255, 255, 255, 0.9);
            --text-main: #1e293b;
            --text-muted: #64748b;
        }
        body {
            background-color: var(--bg-light);
            background-image: radial-gradient(at 0% 0%, hsla(161, 71%, 90%, 1) 0, transparent 50%);
            font-family: 'Inter', sans-serif;
            display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0;
        }
        .card {
            background: var(--glass-white);
            backdrop-filter: blur(10px);
            padding: 40px;
            border-radius: 24px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.05);
            width: 100%; max-width: 500px;
            border: 1px solid rgba(0,0,0,0.05);
        }
        h2 { color: var(--text-main); margin-bottom: 30px; font-size: 1.5rem; display: flex; align-items: center; gap: 10px; }
        h2::before { content: ""; width: 4px; height: 24px; background: var(--emerald); border-radius: 4px; }
        .input-box { margin-bottom: 20px; display: flex; flex-direction: column; gap: 8px; }
        label { font-size: 0.85rem; font-weight: 600; color: var(--text-muted); }
        input, select { padding: 12px; border-radius: 10px; border: 1px solid #e2e8f0; outline: none; }
        input:focus { border-color: var(--emerald); box-shadow: 0 0 0 4px rgba(16, 185, 129, 0.1); }
        .btn-save { background: var(--emerald); color: white; border: none; padding: 14px; border-radius: 10px; font-weight: 700; cursor: pointer; width: 100%; transition: 0.3s; margin-top: 10px; }
        .btn-save:hover { background: var(--emerald-dark); transform: translateY(-2px); }
        .btn-cancel { display: block; text-align: center; margin-top: 20px; color: var(--text-muted); text-decoration: none; font-size: 0.9rem; font-weight: 500; }
    </style>
</head>
<body>
    <div class="card">
        <h2>Update Student Record</h2>
        <form action="/update/<%= student.id %>" method="POST">
            <div class="input-box">
                <label>Student ID</label>
                <input type="text" name="student_id" value="<%= student.student_id %>" required>
            </div>
            <div class="input-box">
                <label>Full Name</label>
                <input type="text" name="full_name" value="<%= student.full_name %>" required>
            </div>
            <div class="input-box">
                <label>Course</label>
                <input type="text" name="course" value="<%= student.course %>" required>
            </div>
            <div class="input-box">
                <label>Year Level</label>
                <select name="year_level">
                    <option <%= student.year_level == '1st Year' ? 'selected' : '' %>>1st Year</option>
                    <option <%= student.year_level == '2nd Year' ? 'selected' : '' %>>2nd Year</option>
                    <option <%= student.year_level == '3rd Year' ? 'selected' : '' %>>3rd Year</option>
                    <option <%= student.year_level == '4th Year' ? 'selected' : '' %>>4th Year</option>
                </select>
            </div>
            <div class="input-box">
                <label>Email Address</label>
                <input type="email" name="email_address" value="<%= student.email_address %>" required>
            </div>
            <button type="submit" class="btn-save">Update Record</button>
            <a href="/" class="btn-cancel">Cancel and Go Back</a>
        </form>
    </div>
</body>
</html>